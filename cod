const fileInput = document.getElementById("fileInput");
const outputBox = document.getElementById("output");

async function analyzeImage() {
  const file = fileInput.files[0];
  if (!file) {
    outputBox.textContent = "Please upload an image.";
    return;
  }

  // Convert image to Base64
  const base64 = await toBase64(file);

  // Prepare request to Gemini API
  const payload = {
    contents: [
      {
        parts: [
          { text: "Analyze this image for summary, insights, and JSON output." },
          {
            inlineData: {
              mimeType: file.type,
              data: base64.split(',')[1]
            }
          }
        ]
      }
    ]
  };

  // Send request to Gemini Flash model
  const response = await fetch(
    "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=YOUR_API_KEY",
    {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    }
  );

  const data = await response.json();

  // Show output
  outputBox.textContent = data?.candidates?.[0]?.content?.parts?.[0]?.text || "No response";
}

// Convert file to Base64
function toBase64(file) {
  return new Promise((resolve) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.readAsDataURL(file);
  });
}
   
